# Data Engineering environment template.
# Safe local development defaults and placeholders only.
# Copy to data-engineering/.env and edit locally. Do not commit real values.

# MySQL database used by the Python ETL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=unilever_db
MYSQL_USER=root
MYSQL_PASSWORD=Root@123

# Smollan portal automation. Fill these only in your local .env file.
PORTAL_BASE_URL=https://smartmanagement.smollan.com/#/login
PORTAL_USERNAME=
PORTAL_PASSWORD=
PORTAL_ENTITY=Morocco Unilever
DATA_DUMP_REPORT_NAME=Data Dump
COVERAGE_REPORT_NAME=Coverage Data
COVERAGE_LOOKBACK_DAYS=4

# Local file locations for generated/downloaded files.
DOWNLOAD_DIR=./data-engineering/downloads
BACKUP_DIR=./data-engineering/backups
LOG_DIR=./logs
  
# Playwright runtime options.
PORTAL_HEADLESS=false
PORTAL_SLOW_MO_MS=250
PORTAL_TIMEOUT_MS=30000
PORTAL_EXPORT_TIMEOUT_MS=300000
