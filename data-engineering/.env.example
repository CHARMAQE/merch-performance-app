# MySQL database used by the Python ETL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123
DB_NAME=unilever_db

# Smollan portal automation. Replace placeholders locally in .env.
PORTAL_URL=https://smartmanagement.smollan.com/#/login
PORTAL_USER=your_portal_user
PORTAL_PASS=your_portal_password
PORTAL_ENTITY=Morocco Unilever
DATA_DUMP_REPORT_NAME=Data Dump
COVERAGE_REPORT_NAME=Coverage Data
COVERAGE_LOOKBACK_DAYS=4

# Local file locations for downloaded or backed-up Excel files.
UNILEVER_DOWNLOAD_DIR=./data-engineering/downloads
UNILEVER_BACKUP_DIR=./data-engineering/backups

PORTAL_HEADLESS=false
PORTAL_SLOW_MO_MS=250
PORTAL_TIMEOUT_MS=30000
PORTAL_EXPORT_TIMEOUT_MS=300000
