# Local Docker MySQL settings.
# Copy to .env only if you want to override docker-compose defaults.
MYSQL_ROOT_PASSWORD=Root@123
MYSQL_DATABASE=unilever_db
MYSQL_PORT=3306

# Spring Boot backend environment overrides.
# Export these in your shell only if you want to override application.properties.
DB_URL=jdbc:mysql://localhost:3306/unilever_db
DB_USER=root
DB_PASSWORD=Root@123
SERVER_PORT=9000
