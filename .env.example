# Root project environment template.
# Safe local development defaults only. Do not put real portal credentials here.
#
# Copy this file to .env only when you want to override Docker/backend defaults.
# The local .env file is ignored by Git and must not be committed.

# Docker MySQL defaults used by docker-compose.yml.
MYSQL_ROOT_PASSWORD=Root@123
MYSQL_DATABASE=unilever_db
MYSQL_PORT=3306

# Spring Boot backend database overrides.
DB_URL=jdbc:mysql://localhost:3306/unilever_db
DB_USER=root
DB_PASSWORD=Root@123
SERVER_PORT=9000
